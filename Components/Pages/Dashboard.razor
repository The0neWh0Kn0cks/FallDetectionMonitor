    private class DashboardPerson
    {
        public int WearableDeviceId { get; set; }
        public int PatientId { get; set; }
        public int? ActiveAlertId { get; set; }

        public string DeviceCode { get; set; } = "";
        public string Name { get; set; } = "";
        public int Age { get; set; }
        public string Location { get; set; } = "Home";
        public string MedicalHistory { get; set; } = "Medical history not recorded yet";

        public bool HasNextOfKin { get; set; } = true;
        public string NextOfKinName { get; set; } = "";
        public string NextOfKinNumber { get; set; } = "";

        public double PressureHpa { get; set; }
        public double AltitudeM { get; set; }

        public double AccelX { get; set; }
        public double AccelY { get; set; }
        public double AccelZ { get; set; }

        public double GyroX { get; set; }
        public double GyroY { get; set; }
        public double GyroZ { get; set; }

        public bool FallDetected { get; set; }
        public bool LedActive { get; set; }
        public bool BuzzerActive { get; set; }

        public DateTime? RecordedAt { get; set; }
        public DateTime? FallDetectedAt { get; set; }

        public DateTime? EmergencyServicesCalledAt { get; set; }
        public DateTime? NextOfKinCalledAt { get; set; }

        public string NextOfKinNameText
        {
            get
            {
                if (!HasNextOfKin || string.IsNullOrWhiteSpace(NextOfKinName))
                {
                    return "Not recorded yet";
                }

                return NextOfKinName;
            }
        }

        public string NextOfKinNumberText
        {
            get
            {
                if (!HasNextOfKin || string.IsNullOrWhiteSpace(NextOfKinNumber))
                {
                    return "Not recorded yet";
                }

                return NextOfKinNumber;
            }
        }

        public string RecordedAtText
        {
            get
            {
                return RecordedAt?.ToString("dd/MM/yyyy hh:mm:ss tt") ?? "--";
            }
        }

        public string FallDetectedAtText
        {
            get
            {
                return FallDetectedAt?.ToString("dd/MM/yyyy hh:mm:ss tt") ?? "--";
            }
        }

        public string EmergencyServicesCalledAtText
        {
            get
            {
                return EmergencyServicesCalledAt?.ToString("dd/MM/yyyy hh:mm:ss tt") ?? "Not recorded yet";
            }
        }

        public string NextOfKinCalledAtText
        {
            get
            {
                return NextOfKinCalledAt?.ToString("dd/MM/yyyy hh:mm:ss tt") ?? "Not recorded yet";
            }
        }

        public string ActionTakenText
        {
            get
            {
                bool emergencyCalled = EmergencyServicesCalledAt != null;
                bool nextOfKinCalled = NextOfKinCalledAt != null;

                if (emergencyCalled && nextOfKinCalled)
                {
                    return $"Emergency called at {EmergencyServicesCalledAtText}; Next-of-kin called at {NextOfKinCalledAtText}";
                }

                if (emergencyCalled)
                {
                    return $"Emergency called at {EmergencyServicesCalledAtText}";
                }

                if (nextOfKinCalled)
                {
                    return $"Next-of-kin called at {NextOfKinCalledAtText}";
                }

                return "No action recorded yet";
            }
        }
    }
}