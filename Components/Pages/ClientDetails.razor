    private class FallHistoryRow
    {
        public DateTime FallDetectedAt { get; set; }
        public DateTime LastUpdatedAt { get; set; }

        public DateTime? EmergencyServicesCalledAt { get; set; }
        public DateTime? NextOfKinCalledAt { get; set; }
        public DateTime? ResolvedAt { get; set; }
        public string ResolutionType { get; set; } = "";
        public string ResetReason { get; set; } = "";

        public string FallDetectedAtText
        {
            get
            {
                return FallDetectedAt.ToString("dd/MM/yyyy hh:mm:ss tt");
            }
        }

        public string LastUpdatedAtText
        {
            get
            {
                return LastUpdatedAt.ToString("dd/MM/yyyy hh:mm:ss tt");
            }
        }

        public string ActionTakenText
        {
            get
            {
                bool emergencyCalled = EmergencyServicesCalledAt != null;
                bool nextOfKinCalled = NextOfKinCalledAt != null;
                bool resolved = ResolvedAt != null;

                if (emergencyCalled && nextOfKinCalled)
                {
                    return "Emergency services and next-of-kin called";
                }

                if (emergencyCalled)
                {
                    return "Emergency services called";
                }

                if (nextOfKinCalled)
                {
                    return "Next-of-kin called";
                }

                if (resolved)
                {
                    if (ResolutionType == "Cleared")
                    {
                        return "Cleared";
                    }

                    if (ResolutionType == "Reset")
                    {
                        return "Reset";
                    }

                    return "Resolved";
                }

                return "No action recorded yet";
            }
        }

        public string ActionTakenAtText
        {
            get
            {
                DateTime? actionTime = EmergencyServicesCalledAt
                    ?? NextOfKinCalledAt
                    ?? ResolvedAt;

                return actionTime?.ToString("dd/MM/yyyy hh:mm:ss tt") ?? "--";
            }
        }

        public string ResetReasonText
        {
            get
            {
                if (string.IsNullOrWhiteSpace(ResetReason))
                {
                    return "--";
                }

                return ResetReason;
            }
        }
    }

